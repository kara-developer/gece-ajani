    for d in gruplar["kalan"]:
        satir(d, f"[{ETIKET[d['durum']]}] ")
    print(f"SORUNLU ({len(gruplar['sorun'])})")
    for d in gruplar["sorun"]:
        satir(d, f"[{ETIKET[d['durum']]}] ")
    k = gruplar["kapali"]
    print(f"KAPANAN: {sum(d['durum'] == 'kabul' for d in k)} kabul, {sum(d['durum'] == 'red' for d in k)} red")
    print("-" * 78)
    print("Taslagi gor: gece goster ID   |   gece kabul ID   |   gece red ID --not \"neden\"   |   gece tekrar ID")
    print("Hatirlatma: cikti TASLAKTIR. Kabul etmeden once cikti klasorundeki dosyayi kendin oku.")


