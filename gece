def ayar(ad, varsayilan):
    ham = os.environ.get(ad)
    if ham in (None, ""):
        return varsayilan
    try:
        return type(varsayilan)(ham)
    except ValueError:
        sys.exit(f"{ad}={ham!r} gecersiz (beklenen: {type(varsayilan).__name__})")


def simdi():
    return datetime.now().strftime("%Y-%m-%d %H:%M:%S")


def sade(s):
    """Basliklari Turkce karakterden bagimsiz karsilastir."""
    s = s.replace("İ", "i").replace("I", "i").lower()
    for a, b in zip("çğıöşü", "cgiosu"):
        s = s.replace(a, b)
    return s.strip(" :")


# ---------------------------------------------------------------- brief
def brief_ayristir(metin):
    ust, govde = {}, metin
    m = re.match(r"\A---\s*\n(.*?)\n---\s*\n?(.*)\Z", metin, re.S)
    if m:
        for satir in m.group(1).splitlines():
            if ":" in satir and not satir.strip().startswith("#"):
                k, v = satir.split(":", 1)
                ust[sade(k)] = v.strip()
        govde = m.group(2)
    bolumler, baslik = {}, None
    for satir in govde.splitlines():
        h = re.match(r"##\s+(.+)", satir)
        if h:
            baslik = sade(h.group(1))
            bolumler[baslik] = []
        elif baslik:
            bolumler[baslik].append(satir)
    bolumler = {k: re.sub(r"<!--.*?-->", "", "\n".join(v), flags=re.S).strip() for k, v in bolumler.items()}
    return ust, govde, bolumler


def brief_dogrula(ust, bolumler):
    hatalar = [f"'## {b}' bolumu yok ya da bos" for b in GEREKLI if not bolumler.get(b)]
    if sade(ust.get("mod", "oku")) not in ("oku", "yaz"):
        hatalar.append("mod: 'oku' ya da 'yaz' olmali")
    if sade(ust.get("ajan", "")) not in ("", "claude", "codex", "ozel"):
        hatalar.append("ajan: claude | codex | ozel")
    try:
        float(ust.get("sure", "30"))
    except ValueError:
        hatalar.append("sure: dakika cinsinden sayi olmali")
    return hatalar


# ---------------------------------------------------------------- durum
def durum_oku(i):
    return json.loads((ISLER / i / "durum.json").read_text())


def durum_yaz(i, d):
    p = ISLER / i / "durum.json"
    gecici = p.with_suffix(".tmp")
    gecici.write_text(json.dumps(d, ensure_ascii=False, indent=2))
    os.replace(gecici, p)


def durum_guncelle(i, **kw):
    d = durum_oku(i)
    d.update(kw)
    durum_yaz(i, d)
    return d


def is_idleri():
    if not ISLER.exists():
        return []
    return sorted(p.name for p in ISLER.iterdir() if (p / "durum.json").exists())


def kimlik_coz(girdi):
    tum = is_idleri()
    if girdi in tum:
        return girdi
    adaylar = [i for i in tum if i.split("-", 1)[0] == girdi.zfill(3)]
    if len(adaylar) == 1:
        return adaylar[0]
    sys.exit(f"is bulunamadi: {girdi}  (liste icin: gece liste)")


def log(i, mesaj):
    with open(ISLER / i / "log.txt", "a") as f:
        f.write(f"[{simdi()}] {mesaj}\n")


