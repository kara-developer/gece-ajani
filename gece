        print("not:", d["not"])
    print(f"klasor: {jd}/cikti/")
    sonuc = jd / "cikti" / "sonuc.md"
    if sonuc.exists():
        print("\n----- sonuc.md -----")
        print(sonuc.read_text())
    fark = jd / "cikti" / "degisiklik.diff"
    if fark.exists():
        satirlar = fark.read_text().splitlines()
        print(f"\n----- degisiklik.diff ({len(satirlar)} satir) -----")
        print("\n".join(satirlar[:120]))
        print(f"\nUygulamak icin (kabul ettiysen):\n  cd {d['klasor']} && patch -p1 < {fark}")
    if d["durum"] in ("hata", "zaman_asimi"):
        print("\n----- log.txt (son 40 satir) -----")
        print("\n".join((jd / "log.txt").read_text().splitlines()[-40:]))


def cmd_kabul(a):
    i = kimlik_coz(a.id)
    d = durum_oku(i)
    if d["durum"] != "taslak":
        sys.exit(f"yalniz 'taslak' kabul edilir (simdi: {d['durum']})")
    durum_guncelle(i, durum="kabul", **{"not": a.not_ or ""})
    log(i, f"KABUL {a.not_ or ''}")
    print(f"{i} kabul edildi.")
    if d["mod"] == "yaz":
        print(f"Degisiklik otomatik UYGULANMAZ. Uygulamak icin: gece goster {i}")


def cmd_red(a):
    i = kimlik_coz(a.id)
    d = durum_oku(i)
    if d["durum"] != "taslak":
        sys.exit(f"yalniz 'taslak' reddedilir (simdi: {d['durum']})")
    if not a.not_:
        sys.exit("red icin --not ile gerekce yaz (sonraki brief'i iyilestirir)")
    durum_guncelle(i, durum="red", **{"not": a.not_})
    log(i, f"RED {a.not_}")
    print(f"{i} reddedildi. Brief'i duzeltip yeniden ekle ya da: gece tekrar {i}")


def cmd_tekrar(a):
    i = kimlik_coz(a.id)
    d = durum_oku(i)
    if d["durum"] not in ("hata", "zaman_asimi", "red", "bekliyor"):
        sys.exit(f"tekrar yalniz hata/zaman_asimi/red icin (simdi: {d['durum']})")
    durum_guncelle(i, durum="bekliyor", **{"not": "tekrar kuyruga alindi"})
    print(f"{i} tekrar kuyrukta.")


def main():
    p = argparse.ArgumentParser(prog="gece", description="Gece is kuyrugu")
    s = p.add_subparsers(dest="komut", required=True)
    s.add_parser("doctor").set_defaults(f=cmd_doctor)
    s.add_parser("sablon").set_defaults(f=cmd_sablon)
    s.add_parser("liste").set_defaults(f=cmd_liste)
    s.add_parser("ozet").set_defaults(f=cmd_ozet)
    x = s.add_parser("ekle"); x.add_argument("brief"); x.set_defaults(f=cmd_ekle)
    x = s.add_parser("calistir"); x.add_argument("--sure", type=float, help="saniye; bu sureden sonra yeni is baslamaz"); x.set_defaults(f=cmd_calistir)
    x = s.add_parser("goster"); x.add_argument("id"); x.set_defaults(f=cmd_goster)
    x = s.add_parser("kabul"); x.add_argument("id"); x.add_argument("--not", dest="not_"); x.set_defaults(f=cmd_kabul)
    x = s.add_parser("red"); x.add_argument("id"); x.add_argument("--not", dest="not_"); x.set_defaults(f=cmd_red)
    x = s.add_parser("tekrar"); x.add_argument("id"); x.set_defaults(f=cmd_tekrar)
    a = p.parse_args()
    a.f(a)


if __name__ == "__main__":
    main()
