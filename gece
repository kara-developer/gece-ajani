def ajan_komutu(d, cwd, prompt_dosya):
    """(komut, shell_mi) dondurur. Prompt stdin'den gider."""
    ozel = os.environ.get("GECE_AJAN_KOMUT")
    if ozel:
        return ozel, True
    yaz = d["mod"] == "yaz"
    if d["ajan"] == "claude":
        araclar = "Read,Glob,Grep" + (",Write,Edit" if yaz else "")
        if d["izinler"]:
            araclar += "," + d["izinler"]
        return [ayar("GECE_CLAUDE", "claude"), "-p", "--allowedTools", araclar], False
    if d["ajan"] == "codex":
        return [ayar("GECE_CODEX", "codex"), "exec", "-s", "workspace-write" if yaz else "read-only",
                "-C", str(cwd), "--skip-git-repo-check", "-"], False
    sys.exit("ajan 'ozel' icin GECE_AJAN_KOMUT ortam degiskeni gerekli")


KURALLAR = """GECE KURALLARI (degismez, brief'ten once gelir)
- Bu oturum gozetimsiz. Ciktin TASLAKTIR; sabah bir insan inceleyip kabul ya da red eder.
- Disariya hicbir sey gonderme: e-posta, mesaj, yayin, odeme, form, disa yazan API cagrisi,
  git push, deploy YOK. Brief istese bile yapma; sonucta "yapmadim: <ne>" yaz.
- Yalniz calisma klasorunde calis. Disina cikma. Anahtar, sifre, .env, token dosyalarini okuma
  ve ciktiya koyma.
- Emin degilsen uydurma: "bilmiyorum" ya da "dogrulanamadi" yaz.
- Brief'teki KABUL OLCUTUNE gore kendini kontrol et; karsilamiyorsan hangi madde eksik, soyle.
{mod}

--- BRIEF ---
{brief}
"""
MOD_OKU = "- Mod: SALT-OKUNUR. Hicbir dosyayi degistirme. Sonucu cevap olarak, tam metin yaz (sistem sonuc.md'ye kaydeder)."
MOD_YAZ = ("- Mod: YAZAR, ama calisma klasoru bir KOPYA; orijinal etkilenmez. Dosyalari degistirebilirsin. "
           "Sonda ne yaptigini ve neyi test ettigini cevap olarak ozetle.")


def kopyala(kaynak, hedef):
    toplam = 0
    sinir = ayar("GECE_KOPYA_MB", 500.0) * 1e6
    for yol, _, dosyalar in os.walk(kaynak):
        for f in dosyalar:
            try:
                toplam += os.path.getsize(os.path.join(yol, f))
            except OSError:
                pass
        if toplam > sinir:
            raise RuntimeError(f"klasor {sinir/1e6:.0f} MB'tan buyuk; isi kucuk bir klasorle sinirla (GECE_KOPYA_MB)")
    yoksay = shutil.ignore_patterns(".git", "node_modules", "__pycache__", ".venv", "*.pyc", ".env", ".env.*")
    shutil.copytree(kaynak, hedef, ignore=yoksay, symlinks=True)


def alt_surec(komut, shell, cwd, girdi, zaman_asimi, env):
    p = subprocess.Popen(komut, shell=shell, cwd=cwd, env=env, stdin=subprocess.PIPE,
                         stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, start_new_session=True)
    try:
        out, err = p.communicate(girdi, timeout=zaman_asimi)
        return p.returncode, out, err, False
    except subprocess.TimeoutExpired:
        for sinyal, bekle in ((signal.SIGTERM, 5), (signal.SIGKILL, 5)):
            try:
                os.killpg(p.pid, sinyal)
            except ProcessLookupError:
                break
            try:
                out, err = p.communicate(timeout=bekle)
                break
            except subprocess.TimeoutExpired:
                out = err = ""
        return -9, out or "", err or "", True


def is_calistir(i, dur):
    """Tek isi bitirir. dur: threading.Event (sure doldu / durdur). Durumu isler."""
    d = durum_oku(i)
    jd = ISLER / i
    cikti = jd / "cikti"
    yaz = d["mod"] == "yaz"
    try:
        if yaz and not (jd / "b").exists():
            kopyala(d["klasor"], jd / "a")
            kopyala(d["klasor"], jd / "b")
        cwd = jd / "b" if yaz else Path(d["klasor"])
        brief = (jd / "brief.md").read_text()
        prompt = KURALLAR.format(mod=MOD_YAZ if yaz else MOD_OKU, brief=brief)
        (jd / "prompt.txt").write_text(prompt)
    except Exception as e:  # kopya/okuma hatasi
        durum_guncelle(i, durum="hata", **{"not": f"hazirlik: {e}"})
        log(i, f"hazirlik hatasi: {e}")
        return
    try:
        komut, shell = ajan_komutu(d, cwd, jd / "prompt.txt")
    except SystemExit as e:
        durum_guncelle(i, durum="hata", **{"not": str(e)})
        return
    env = dict(os.environ, GECE_IS_ID=i, GECE_IS_DIZIN=str(jd), CIKTI_KLASORU=str(cikti),
               CALISMA_KLASORU=str(cwd), GECE_MOD=d["mod"], BRIEF_DOSYA=str(jd / "brief.md"),
               PROMPT_DOSYA=str(jd / "prompt.txt"))
    limit_deneme = ayar("GECE_LIMIT_DENEME", 8)
    bekle = ayar("GECE_LIMIT_BEKLE", 1800.0)
    for deneme in range(1, limit_deneme + 2):
        t0 = time.monotonic()
        durum_guncelle(i, durum="calisiyor", deneme=d["deneme"] + deneme, basladi=simdi())
        log(i, f"basladi (deneme {deneme}) komut: {komut if shell else ' '.join(komut)}")
        try:
            rc, out, err, zaman_asimi = alt_surec(komut, shell, cwd, prompt, d["sure_dk"] * 60, env)
        except FileNotFoundError as e:
            durum_guncelle(i, durum="hata", **{"not": f"ajan komutu bulunamadi: {e.filename}"})
            log(i, f"komut yok: {e}")
            return
        sure = time.monotonic() - t0
        with open(jd / "log.txt", "a") as f:
            f.write(f"--- stdout ---\n{out}\n--- stderr ---\n{err}\n--- cikis: {rc}  sure: {sure:.0f}s ---\n")
        if zaman_asimi:
            durum_guncelle(i, durum="zaman_asimi", sure_sn=round(sure), **{"not": f"{d['sure_dk']:g} dk sinirini asti, durduruldu"})
            return
        if rc != 0 and LIMIT_RE.search(out[-2000:] + err[-2000:]):
            if deneme > limit_deneme:
                durum_guncelle(i, durum="bekliyor", **{"not": f"limit {limit_deneme} kez bekletti; sonraki calistirmada denenir"})
                return
            durum_guncelle(i, durum="limit_bekliyor", **{"not": f"limit doldu, {bekle:g} sn sonra devam ({deneme}/{limit_deneme})"})
            log(i, f"limit/kota sinyali; {bekle:g} sn bekleniyor")
            if dur.wait(bekle):  # sure doldu: isi sonraki geceye birak
                durum_guncelle(i, durum="bekliyor", **{"not": "limit beklerken sure doldu; sonraki calistirmada devam"})
                return
            continue
        if rc != 0:
            durum_guncelle(i, durum="hata", sure_sn=round(sure), **{"not": f"ajan {rc} koduyla cikti (log.txt)"})
            return
        if not out.strip():
            durum_guncelle(i, durum="hata", sure_sn=round(sure), **{"not": "ajan bos cikti verdi"})
            return
        (cikti / "sonuc.md").write_text(out)
        if yaz:
            fark = subprocess.run(["diff", "-ruN", "a", "b"], cwd=jd, capture_output=True, text=True).stdout
            (cikti / "degisiklik.diff").write_text(fark)
        kontrol = "yok"
        if d["kontrol"]:
            try:
                r = subprocess.run(d["kontrol"], shell=True, cwd=cikti, env=env, capture_output=True, text=True, timeout=120)
                kontrol = "gecti" if r.returncode == 0 else "KALDI"
                log(i, f"otomatik kontrol: {kontrol}\n{r.stdout[-800:]}{r.stderr[-800:]}")
            except subprocess.TimeoutExpired:
                kontrol = "KALDI"
                log(i, "otomatik kontrol zaman asimi")
        durum_guncelle(i, durum="taslak", sure_sn=round(sure), kontrol=kontrol, bitti=simdi(), **{"not": ""})
        log(i, f"taslak hazir ({sure:.0f} sn, kontrol: {kontrol})")
        return


def cmd_calistir(a):
    ISLER.mkdir(parents=True, exist_ok=True)
    kilit = open(KOK / ".kilit", "w")
    try:
        fcntl.flock(kilit, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        sys.exit("baska bir 'gece calistir' zaten calisiyor; ikincisi baslatilmadi.")
    for i in is_idleri():  # onceki calistirma olduyse yarim kalan isleri geri al
        if durum_oku(i)["durum"] in ("calisiyor", "limit_bekliyor"):
            durum_guncelle(i, durum="bekliyor", **{"not": "onceki calistirma yarida kesildi; yeniden denenecek"})
    isci = ayar("GECE_ISCI", 1)
    if isci > ISCI_TAVAN:
        print(f"UYARI: GECE_ISCI={isci} istendi, tavan {ISCI_TAVAN}; {ISCI_TAVAN} kullaniliyor.")
    isci = min(max(isci, 1), ISCI_TAVAN)
    sure = a.sure if a.sure is not None else ayar("GECE_SURE", 8 * 3600.0)
    bitis = time.monotonic() + sure
    mola, esik, yuk_bekle = ayar("GECE_MOLA", 120.0), ayar("GECE_YUK_ESIK", 5.0), ayar("GECE_YUK_BEKLE", 600.0)
    kuyruk = [i for i in is_idleri() if durum_oku(i)["durum"] == "bekliyor"]
    t_basla = simdi()
    sonuc = {"basladi": t_basla, "bitti": None, "isci": isci, "islenen": 0, "durdu": ""}
    print(f"[{t_basla}] {len(kuyruk)} is, {isci} isci, sure siniri {sure:g} sn, yuk esigi {esik}")
    sira, sira_kilit, dur = list(kuyruk), threading.Lock(), threading.Event()
    sayac = {"n": 0}

    def zamanlayici():
        if not dur.wait(max(0, bitis - time.monotonic())):
            sonuc["durdu"] = sonuc["durdu"] or "sure doldu"
            dur.set()
    threading.Thread(target=zamanlayici, daemon=True).start()

    def isci_dongusu(no):
        ilk = True
        while not dur.is_set():
            if not ilk:
                with sira_kilit:
                    if not sira:  # kuyruk bitti, bosuna mola yok
                        return
                if dur.wait(mola):  # isler arasi mola
                    return
            ilk = False
            bekleme = time.monotonic()
            while yuk() > esik:  # makine mesgulse baslama
                if time.monotonic() - bekleme > yuk_bekle:
                    sonuc["durdu"] = f"makine yuku {yuk():.1f} > {esik} ({yuk_bekle:g} sn beklendi)"
                    dur.set()
                    return
                if dur.wait(min(5.0, max(0.2, yuk_bekle / 10))):
                    return
            with sira_kilit:
                if not sira:
                    return
                i = sira.pop(0)
            print(f"[{simdi()}] isci{no}: {i} basliyor")
            is_calistir(i, dur)
            sayac["n"] += 1
            print(f"[{simdi()}] isci{no}: {i} -> {durum_oku(i)['durum']}")

    isciler = [threading.Thread(target=isci_dongusu, args=(n + 1,)) for n in range(isci)]
    try:
        for t in isciler:
            t.start()
        for t in isciler:
            t.join()
    except KeyboardInterrupt:
        dur.set()
        print("durduruluyor...")
    dur.set()
    sonuc.update(bitti=simdi(), islenen=sayac["n"])
    (KOK / "son-calistirma.json").write_text(json.dumps(sonuc, ensure_ascii=False, indent=2))
    print(f"[{simdi()}] bitti: {sayac['n']} is islendi." + (f" Durma nedeni: {sonuc['durdu']}." if sonuc["durdu"] else ""))
    print("Sabah icin: gece ozet")


