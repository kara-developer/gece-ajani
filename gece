    gruplar = {"taslak": [], "kalan": [], "sorun": [], "kapali": []}
    for i in idler:
        d = durum_oku(i)
        gruplar[{"taslak": "taslak", "bekliyor": "kalan", "calisiyor": "kalan", "limit_bekliyor": "kalan",
                 "hata": "sorun", "zaman_asimi": "sorun", "kabul": "kapali", "red": "kapali"}[d["durum"]]].append(d)
