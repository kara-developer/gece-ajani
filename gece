    ust = f"GECE OZETI  {simdi()[:16]}"
    if son.exists():
        s = json.loads(son.read_text())
        ust += f"   son calistirma: {s['basladi'][5:16]} -> {(s['bitti'] or '?')[5:16]}, {s['islenen']} is"
        if s.get("durdu"):
            ust += f" ({s['durdu']})"
    print(ust)
    print("=" * 78)

    def satir(d, ek=""):
        sn = d.get("sure_sn")
        sure = f"{sn // 60}dk{sn % 60:02d}" if sn is not None else "-"
        print(f"  {d['id']:<30} {sure:>7}  {ek}{d['not'] or ''}")

    print(f"TASLAK - inceleme bekliyor ({len(gruplar['taslak'])})")
    for d in gruplar["taslak"]:
        satir(d, f"kontrol:{d.get('kontrol', '-')}  ")
